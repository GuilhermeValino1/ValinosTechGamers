<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Recuperar Acesso - Valino's Tech Games</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body { background-color: #0d0d0d; color: #fff; font-family: 'Roboto', sans-serif; }
        h2 { font-family: 'Orbitron', sans-serif; color: #00ff88; text-shadow: 0 0 10px rgba(0, 255, 136, 0.3); }
        .card-custom { background-color: #1a1a1a; border: 1px solid #333; }
        .btn-gamer { background-color: #00ff88; color: #000; font-weight: bold; border: none; }
        .btn-gamer:hover { background-color: #00cc6e; color: #000; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center" style="min-height: 100vh;">

    <div class="card card-custom p-4 shadow-lg" style="width: 100%; max-width: 450px;">
        <div class="text-center mb-4">
            <h2>RECUPERAR CONTA</h2>
            <p class="text-secondary small">Insira seu e-mail para receber o código de reset</p>
        </div>

        <div th:if="${erro}" class="alert alert-danger bg-dark text-danger border-danger small" th:text="${erro}"></div>
        <div th:if="${sucesso}" class="alert alert-success bg-dark text-success border-success small" th:text="${sucesso}"></div>

        <form th:action="@{/esqueci-senha}" method="post">
            <div class="mb-4">
                <label class="form-label text-secondary small">E-mail Cadastrado</label>
                <input type="email" name="email" class="form-control form-control-lg bg-dark text-white border-secondary" placeholder="gamer@valinostech.com" required>
            </div>
            <button type="submit" class="btn btn-gamer w-100 py-2 mb-3">ENVIAR LINK DE CONFIGURAÇÃO</button>
            <div class="text-center">
                <a href="/login" class="text-secondary small text-decoration-none">Voltar para o Login</a>
            </div>
        </form>
    </div>

</body>
</html>