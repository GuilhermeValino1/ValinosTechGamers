<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Nova Senha - Valino's Tech Games</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body { background-color: #0d0d0d; color: #fff; }
        h2 { font-family: 'Orbitron', sans-serif; color: #00ff88; }
        .card-custom { background-color: #1a1a1a; border: 1px solid #333; }
        .btn-gamer { background-color: #00ff88; color: #000; font-weight: bold; border: none; }
        .btn-gamer:hover { background-color: #00cc6e; color: #000; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center" style="min-height: 100vh;">

    <div class="card card-custom p-4 shadow-lg" style="width: 100%; max-width: 450px;">
        <div class="text-center mb-4">
            <h2>NOVA SENHA</h2>
            <p class="text-secondary small">Altere os parâmetros secretos de segurança da sua conta</p>
        </div>

        <form th:action="@{/redefinir-senha}" method="post">
            <input type="hidden" name="token" th:value="${token}">
            
            <div class="mb-4">
                <label class="form-label text-secondary small">Nova Senha UltraSegura</label>
                <input type="password" name="senha" class="form-control form-control-lg bg-dark text-white border-secondary" placeholder="********" required minlength="6">
            </div>
            
            <button type="submit" class="btn btn-gamer w-100 py-2">REDEFINIR PARAMETROS</button>
        </form>
    </div>

</body>
</html>